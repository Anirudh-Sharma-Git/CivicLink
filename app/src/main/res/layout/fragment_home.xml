<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".HomeFragment">

    <!-- The AppBarLayout contains everything that should be part of the fixed/collapsing header -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp">

            <!-- Search Bar (No changes here) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search_bar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_search" />
                <EditText
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_issues_hint"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="16sp"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Filter Chips (No changes here) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/chip_all"
                        style="@style/ChipStyle"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/selector_chip_background"
                        android:text="@string/filter_all"
                        android:textColor="@color/selector_chip_text_color" />
                    <TextView
                        android:id="@+id/chip_pending"
                        style="@style/ChipStyle"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/selector_chip_background"
                        android:text="@string/filter_pending"
                        android:textColor="@color/selector_chip_text_color" />
                    <TextView
                        android:id="@+id/chip_in_progress"
                        style="@style/ChipStyle"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/selector_chip_background"
                        android:text="@string/filter_in_progress"
                        android:textColor="@color/selector_chip_text_color" />
                    <TextView
                        android:id="@+id/chip_resolved"
                        style="@style/ChipStyle"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/selector_chip_background"
                        android:text="@string/filter_resolved"
                        android:textColor="@color/selector_chip_text_color" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- The Interactive Google Map -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <fragment
                    android:id="@+id/map"
                    android:name="com.google.android.gms.maps.SupportMapFragment"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- THE ONLY CHANGE: The "Expand" button you wanted -->
                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/expandMapButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    app:fabSize="mini"
                    android:src="@drawable/ic_fullscreen"
                    app:backgroundTint="@color/logo_background"
                    app:tint="@color/white"
                    android:contentDescription="Expand Map"/>

            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp"/>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- The dynamic list of issue cards (No changes here) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/issuesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="100dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/issue_card_item" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>