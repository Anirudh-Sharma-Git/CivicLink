<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MyReportsFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/app_background"
        app:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/my_reports_title"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/my_reports_chip_all"
                        style="@style/ChipStyle"
                        android:background="@drawable/selector_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/filter_all"
                        android:textColor="@color/selector_chip_text_color" />

                    <TextView
                        android:id="@+id/my_reports_chip_pending"
                        style="@style/ChipStyle"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/filter_pending"
                        android:textColor="@color/selector_chip_text_color" />

                    <TextView
                        android:id="@+id/my_reports_chip_in_progress"
                        style="@style/ChipStyle"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/filter_in_progress"
                        android:textColor="@color/selector_chip_text_color" />

                    <TextView
                        android:id="@+id/my_reports_chip_resolved"
                        style="@style/ChipStyle"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/selector_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/filter_resolved"
                        android:textColor="@color/selector_chip_text_color" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/myReportsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="16dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/issue_card_item" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>